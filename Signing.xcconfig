// Ad-hoc by default. The widget can read the app group only from a team-signed build;
// put your identity in Signing.local.xcconfig:
//
//     CODE_SIGN_IDENTITY = Apple Development
//     DEVELOPMENT_TEAM = YOURTEAMID

CODE_SIGN_IDENTITY = -
CODE_SIGN_STYLE = Manual

#include? "Signing.local.xcconfig"
